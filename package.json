{
  "name": "soop-chat",
  "version": "0.3.0",
  "description": "Unofficial typed SOOP live chat reader for Node.js and browsers",
  "keywords": [
    "live-chat",
    "soop",
    "typescript",
    "websocket"
  ],
  "bugs": {
    "url": "https://github.com/joyfuI/soop-chat/issues"
  },
  "license": "MIT",
  "author": "joyfuI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyfuI/soop-chat.git"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build",
    "test": "npm run test:unit",
    "test:unit": "npm run build:test && node --test .test-dist/test/*.test.js",
    "test:browser": "npm run build && playwright test",
    "test:live": "npm run build && node test/live-smoke.mjs",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
